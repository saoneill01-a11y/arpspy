<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Needed with Apple's hardened runtime (required for notarization): macOS shows Wi-Fi network names only to apps
     allowed to use Location. No App Sandbox: it blocks the scanner's raw network calls. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
